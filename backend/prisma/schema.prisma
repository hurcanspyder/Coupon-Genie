datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // "USER" or "ADMIN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  savedCoupons UserSavedCoupon[]
}

model Store {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logo        String
  description String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coupons     Coupon[]
}

model Coupon {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  couponCode    String
  title         String
  description   String?
  discountType  String   // "PERCENTAGE" or "FLAT"
  discountValue Float
  expiryDate    DateTime
  active        Boolean  @default(true)
  terms         String?
  revealCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  savedByUsers  UserSavedCoupon[]
}

model UserSavedCoupon {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@id([userId, couponId])
}
